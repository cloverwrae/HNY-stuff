.starshower {
    font-size: 1.5em;
    text-shadow: 0 0 3px lavenderblush
    }
@-webkit-keyframes starshowers-fall {
    0% {
        top: -10%;
        } 100% {
        top: 100%;
        }
    }
@-webkit-keyframes starshowers-shake {
    0% {
        transform: translateX(0);
        } 100% {
        transform: translateX(-500px);
        }
    }
@keyframes starshowers-fall {
    0% {
        top: -10%;
        } 100% {
        top: 100%;
        }
    }
@keyframes starshowers-shake {
    0% {
        transform: translateX(0);
        } 100% {
        transform: translateX(-500px);
        }
    }
.starshower {
    position: fixed;
    top: -10%;
    z-index: 9999;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    pointer-events: none;
    cursor: default;
    -webkit-animation-name: starshowers-fall, starshowers-shake;
    -webkit-animation-duration: 10s, 10s;
    -webkit-animation-timing-function: linear, linear;
    -webkit-animation-iteration-count: infinite, infinite;
    -webkit-animation-play-state: running, running;
    animation-name: starshowers-fall, starshowers-shake;
    animation-duration: 10s, 10s;
    animation-timing-function: linear, linear;
    animation-iteration-count: infinite, infinite;
    animation-play-state: running, running
    }
.starshower:nth-of-type(0) {
    left: 5%;
    -webkit-animation-delay: 0s, 0s;
    animation-delay: 0s, 0s
    }
.starshower:nth-of-type(1) {
    left: 15%;
    -webkit-animation-delay: 1s, 1s;
    animation-delay: 1s, 1s
    }
